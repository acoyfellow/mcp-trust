{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": false,
    "types": ["bun", "@cloudflare/workers-types"]
  },
  "include": ["src", "test", "experiments", "bin", "dev", "alchemy.run.ts", "alchemy.dev.ts"]
}
