{
  "name": "mcp-trust",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "mcp-trust": "./bin/mcp-trust.ts"
  },
  "description": "An experiment notebook: tool passports, write fences and a flight recorder for MCP gateways.",
  "license": "MIT",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "watch": "bun bin/mcp-trust.ts watch",
    "e1": "bun experiments/tool-passport/run.ts",
    "e1b": "bun experiments/lookalike-provider/run.ts",
    "e2": "bun experiments/write-fence/run.ts",
    "e3": "bun experiments/flight-recorder/run.ts",
    "e3:reconnect": "bun experiments/flight-recorder/reconnect.ts",
    "demo": "bun experiments/demo/run.ts",
    "e2:control": "bun experiments/write-fence/control.ts",
    "mutation": "bun scripts/mutation-check.ts",
    "e4": "bun experiments/flight-stream/run.ts",
    "e5": "bun experiments/access/run.ts"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/domain": "2.0.0-beta.87",
    "@distilled.cloud/cloudflare": "1.0.0-rc.20",
    "@effect/platform-bun": "4.1.5",
    "@effect/platform-node": "4.1.5",
    "@noble/curves": "2.4.0",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/workers-types": "5.20261121.1",
    "@types/bun": "1.4.5",
    "typescript": "7.0.2"
  }
}
